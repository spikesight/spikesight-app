<Window x:Class="SpikeSight.App.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flag player"
        Icon="Assets/spikesight.ico" Width="460" SizeToContent="Height"
        Background="{DynamicResource Surface0}" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal">

    <!-- SizeToContent rather than a fixed height: the first version was a
         StackPanel in a 330px window, which pushed Save off the bottom edge
         and left the close box as the only way out. -->
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource OnHigh}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Primary}"/>
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                                x:Name="Chrome">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{StaticResource Primary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Severity as three buttons rather than radio dots: it is a choice
             of one of three, and this makes the colour part of the choosing. -->
        <Style x:Key="Sev" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Severity"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="{StaticResource Display}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="6" Padding="16,8" Margin="0,0,8,0"
                                Background="{DynamicResource Surface1}"
                                BorderBrush="{DynamicResource Outline}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush"
                                        Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Body}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{StaticResource Primary}"
                                CornerRadius="6" Padding="20,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- who -->
            <RowDefinition Height="Auto"/>   <!-- context -->
            <RowDefinition Height="Auto"/>   <!-- severity label -->
            <RowDefinition Height="Auto"/>   <!-- severity -->
            <RowDefinition Height="Auto"/>   <!-- body label -->
            <RowDefinition Height="Auto"/>   <!-- body -->
            <RowDefinition Height="Auto"/>   <!-- tags label -->
            <RowDefinition Height="Auto"/>   <!-- tags -->
            <RowDefinition Height="Auto"/>   <!-- buttons -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Who" Style="{StaticResource T.Title}" FontSize="18"/>
        <TextBlock Grid.Row="1" x:Name="Context" Style="{StaticResource T.Meta}"
                   Margin="0,3,0,18"/>

        <TextBlock Grid.Row="2" Style="{StaticResource T.Label}" Text="HOW BADLY"
                   Margin="0,0,0,8"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,18">
            <RadioButton x:Name="SevWatch" Style="{StaticResource Sev}" Content="WATCH"
                         Foreground="{StaticResource Secondary}"
                         Tag="{StaticResource SecondarySoft}" IsChecked="True"/>
            <RadioButton x:Name="SevAvoid" Style="{StaticResource Sev}" Content="AVOID"
                         Foreground="{StaticResource Warning}"
                         Tag="{StaticResource WarningSoft}"/>
            <RadioButton x:Name="SevDodge" Style="{StaticResource Sev}" Content="DODGE"
                         Foreground="{StaticResource Primary}"
                         Tag="{StaticResource PrimarySoft}"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Style="{StaticResource T.Label}" Text="WHAT HAPPENED"
                   Margin="0,0,0,8"/>
        <TextBox Grid.Row="5" x:Name="BodyBox" Height="86" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="6" Style="{StaticResource T.Label}" Text="TAGS (COMMA SEPARATED)"
                   Margin="0,0,0,8"/>
        <TextBox Grid.Row="7" x:Name="TagsBox" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource Quiet}" Margin="0,0,10,0"
                    Padding="20,8" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="Save flag" Style="{StaticResource AccentButton}"
                    IsDefault="True" Click="Save"/>
        </StackPanel>
    </Grid>
</Window>
