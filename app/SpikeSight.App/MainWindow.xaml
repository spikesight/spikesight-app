<Window x:Class="SpikeSight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeSight" Height="430" Width="620"
        Background="#0D0F14" ShowActivated="False"
        WindowStartupLocation="CenterScreen">

    <!-- ShowActivated=False is the whole point: the window appears without
         taking foreground, so launching mid-match does not pull the mouse
         out of the game. -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="SPIKE" FontFamily="Segoe UI" FontWeight="Bold" FontSize="22"
                       Foreground="#FF4655"/>
            <TextBlock Text="SIGHT" FontFamily="Segoe UI" FontWeight="Bold" FontSize="22"
                       Foreground="#E6E9EF"/>
            <TextBlock Text="v3 preview" FontFamily="Segoe UI" FontSize="12"
                       Foreground="#98A1B3" Margin="10,9,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Report" FontFamily="Consolas" FontSize="13"
                       Foreground="#E6E9EF" TextWrapping="Wrap" LineHeight="20"/>
        </ScrollViewer>
    </Grid>
</Window>
