<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A small design system, borrowed in structure from Material 3 rather
        than in appearance: tiered surfaces instead of borders, a fixed type
        scale, an 8px spacing grid, and colour roles named for their job.

        The point is that nothing here is decided per control. Every surface,
        size and colour below is one of a handful of choices, which is what
        stops a window drifting into looking hand-assembled.
    -->

    <!-- ===== surfaces: elevation by tone, not by shadow ===== -->
    <SolidColorBrush x:Key="Surface0" Color="#FF0E1116"/>  <!-- the window -->
    <SolidColorBrush x:Key="Surface1" Color="#FF161A22"/>  <!-- cards, rows -->
    <SolidColorBrush x:Key="Surface2" Color="#FF1C222C"/>  <!-- raised, hover -->
    <SolidColorBrush x:Key="Surface3" Color="#FF242C38"/>  <!-- your own row -->
    <SolidColorBrush x:Key="Outline"  Color="#FF262E3A"/>
    <SolidColorBrush x:Key="OutlineSoft" Color="#FF1E242E"/>

    <!-- ===== content: three levels, never more ===== -->
    <SolidColorBrush x:Key="OnHigh"   Color="#FFEDF0F5"/>  <!-- names, values -->
    <SolidColorBrush x:Key="OnMedium" Color="#FFA9B2C1"/>  <!-- supporting -->
    <SolidColorBrush x:Key="OnLow"    Color="#FF788192"/>  <!-- labels, meta -->

    <!-- ===== roles ===== -->
    <SolidColorBrush x:Key="Primary"    Color="#FFFF4655"/>
    <SolidColorBrush x:Key="PrimarySoft" Color="#26FF4655"/>
    <SolidColorBrush x:Key="Secondary"  Color="#FF2FD4BE"/>
    <SolidColorBrush x:Key="SecondarySoft" Color="#222FD4BE"/>
    <SolidColorBrush x:Key="Warning"    Color="#FFE8B04B"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#22E8B04B"/>
    <SolidColorBrush x:Key="Positive"   Color="#FF3DD68C"/>
    <SolidColorBrush x:Key="Negative"   Color="#FFFF5C6E"/>
    <SolidColorBrush x:Key="Transparent" Color="#00000000"/>

    <!-- ===== the overlay's own surfaces: translucent over the game ===== -->
    <SolidColorBrush x:Key="OverlayBg"   Color="#F20E1116"/>
    <SolidColorBrush x:Key="OverlayEdge" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="OverlayLine" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PrimaryWash" Color="#1AFF4655"/>

    <FontFamily x:Key="Body">pack://application:,,,/Assets/Fonts/#Barlow</FontFamily>
    <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Barlow Condensed</FontFamily>

    <!-- ===== type scale ===== -->
    <!-- display 24 | title 17 | body 14 | dense 13 | caption 12 | label 11 -->

    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style x:Key="T.Display" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="T.Dense" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource OnMedium}"/>
    </Style>

    <Style x:Key="T.Caption" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OnMedium}"/>
    </Style>

    <Style x:Key="T.Meta" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OnLow}"/>
    </Style>

    <!-- Column headings and badges: condensed, letterspaced, small. -->
    <Style x:Key="T.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource OnLow}"/>
    </Style>

    <Style x:Key="T.Badge" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Numbers that sit in columns have to line up. -->
    <Style x:Key="T.Numeric" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource OnMedium}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- ===== components ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface1}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tab" TargetType="RadioButton">
        <Setter Property="GroupName" Value="View"/>
        <Setter Property="Foreground" Value="{DynamicResource OnLow}"/>
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,24,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Underline" Padding="1,0,1,7"
                            BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Underline" Property="BorderBrush"
                                    Value="{StaticResource Primary}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Quiet" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource OnMedium}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{DynamicResource Surface2}" CornerRadius="6"
                            BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                            Padding="12,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource Surface3}"/>
                            <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Option" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- The default WPF context menu is a white Windows-9x affair in the
         middle of a dark window. This is the same menu wearing the app. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface2}"/>
        <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Surface2}" CornerRadius="8"
                            BorderBrush="{DynamicResource Outline}" BorderThickness="1"
                            Padding="6" SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.45"
                                              Color="Black"/>
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource OnHigh}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent" CornerRadius="5"
                            Padding="12,7" Margin="0,1">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{DynamicResource Surface3}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource OnLow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,5"/>
        <Setter Property="Background" Value="{DynamicResource Outline}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Outline}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>
