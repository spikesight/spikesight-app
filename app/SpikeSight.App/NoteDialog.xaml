<Window x:Class="SpikeSight.App.NoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flag player" Height="330" Width="440"
        Background="#0D0F14" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E6E9EF"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#151922"/>
            <Setter Property="Foreground" Value="#E6E9EF"/>
            <Setter Property="BorderBrush" Value="#2A3240"/>
            <Setter Property="CaretBrush" Value="#E6E9EF"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock x:Name="Who" FontSize="15" FontWeight="Bold" Margin="0,0,0,2"/>
        <TextBlock x:Name="Context" FontSize="11" Foreground="#6E7687" Margin="0,0,0,14"/>

        <TextBlock Text="HOW BADLY" FontSize="10" Foreground="#6E7687" Margin="0,0,0,5"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton x:Name="SevWatch" Content="Watch" GroupName="Sev" Foreground="#2FB3A4"
                         Margin="0,0,16,0" IsChecked="True"/>
            <RadioButton x:Name="SevAvoid" Content="Avoid" GroupName="Sev" Foreground="#E0A33A"
                         Margin="0,0,16,0"/>
            <RadioButton x:Name="SevDodge" Content="Dodge" GroupName="Sev" Foreground="#FF4655"/>
        </StackPanel>

        <TextBlock Text="WHAT HAPPENED" FontSize="10" Foreground="#6E7687" Margin="0,0,0,5"/>
        <TextBox x:Name="BodyBox" Height="74" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

        <TextBlock Text="TAGS (comma separated)" FontSize="10" Foreground="#6E7687" Margin="0,0,0,5"/>
        <TextBox x:Name="TagsBox" Margin="0,0,0,16"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="84" Padding="0,5" Margin="0,0,8,0"
                    Background="#1C2430" Foreground="#98A1B3" BorderBrush="#2A3240"
                    IsCancel="True"/>
            <Button Content="Save" Width="84" Padding="0,5" IsDefault="True"
                    Background="#FF4655" Foreground="White" BorderBrush="#FF4655"
                    Click="Save"/>
        </StackPanel>
    </StackPanel>
</Window>
