<Window x:Class="SpikeSight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeSight" Height="560" Width="720"
        Background="#0D0F14" ShowActivated="False"
        WindowStartupLocation="CenterScreen">

    <!-- ShowActivated=False is the whole point: the window appears without
         taking foreground, so launching mid-match does not pull the mouse
         out of the game. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E6E9EF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="SPIKE" FontWeight="Bold" FontSize="21" Foreground="#FF4655"/>
            <TextBlock Text="SIGHT" FontWeight="Bold" FontSize="21"/>
            <TextBlock Text="v3 preview" FontSize="12" Foreground="#98A1B3" Margin="10,8,0,0"/>
        </StackPanel>

        <TextBlock x:Name="MatchLine" Grid.Row="1" Margin="0,8,0,10"
                   FontSize="13" Foreground="#98A1B3"/>

        <Grid Grid.Row="2" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="86"/>
                <ColumnDefinition Width="54"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="AGENT"  FontSize="10" Foreground="#6E7687"/>
            <TextBlock Grid.Column="1" Text="PLAYER" FontSize="10" Foreground="#6E7687"/>
            <TextBlock Grid.Column="2" Text="RANK"   FontSize="10" Foreground="#6E7687"/>
            <TextBlock Grid.Column="3" Text="RECENT FORM" FontSize="10" Foreground="#6E7687"/>
            <TextBlock Grid.Column="4" Text="FLAGS"  FontSize="10" Foreground="#6E7687"/>
            <TextBlock Grid.Column="5" Text="LEVEL"  FontSize="10" Foreground="#6E7687"
                       HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#151922" Margin="0,0,0,3" Padding="10,7"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#151922"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter Property="Background" Value="#1C2430"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Agent}" FontSize="12"
                                           Foreground="#98A1B3"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                           Foreground="{Binding NameBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding Rank}" FontSize="13"
                                           Foreground="{Binding RankBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Form}" FontSize="12"
                                           Foreground="#C8CEDA"/>
                                <TextBlock Grid.Column="4" Text="{Binding Smurf}" FontSize="11"
                                           FontWeight="Bold" Foreground="#FF4655"/>
                                <TextBlock Grid.Column="5" Text="{Binding Level}" FontSize="12"
                                           Foreground="#98A1B3" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Diagnostics" Grid.Row="4" Margin="0,12,0,0"
                   FontFamily="Consolas" FontSize="11" Foreground="#6E7687"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
