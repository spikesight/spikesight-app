<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpikeSight.Core\SpikeSight.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- For NotifyIcon: the tray icon ships with the framework, so this
         costs a reference rather than a dependency. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Version>3.0.1-preview</Version>
    <AssemblyTitle>SpikeSight</AssemblyTitle>
    <Product>SpikeSight</Product>
    <!-- The .exe's own icon: what Explorer, the taskbar and alt-tab show,
         before any window exists. -->
    <ApplicationIcon>Assets/spikesight.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms adds global usings that collide with WPF on Brush,
         Application and friends. TrayIcon.cs asks for them explicitly. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent portraits and the project's own typeface, so the window looks
         like the app rather than like a default WPF form. Barlow is OFL and
         converted from the woff2 the web build shipped. -->
    <Resource Include="Assets/spikesight.ico" />
    <Resource Include="Assets/Agents/*.png" />
    <Resource Include="Assets/Fonts/*.ttf" />
  </ItemGroup>

</Project>
