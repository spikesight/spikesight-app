<Window x:Class="SpikeSight.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeSight Overlay"
        Width="354" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False">

    <!-- No chrome, no activation, no taskbar button, no hit testing. The
         equivalent of this in the Python build was a browser window plus
         ctypes to undo everything the browser did to it. -->
    <Border CornerRadius="8" Padding="14" Margin="10"
            Background="#E60D0F14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="SPIKESIGHT" FontFamily="Segoe UI" FontWeight="Bold"
                       FontSize="13" Foreground="#FF4655" Margin="0,0,0,8"/>
            <TextBlock x:Name="Status" Text="overlay up" FontFamily="Segoe UI"
                       FontSize="13" Foreground="#E6E9EF" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
