<Window x:Class="SpikeSight.App.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeSight Overlay"
        Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Focusable="False" IsHitTestVisible="False">

    <!-- No chrome, no activation, no taskbar button, no hit testing. The
         equivalent in the Python build was a browser window plus ctypes to
         undo everything the browser did to it. -->
    <Border CornerRadius="8" Padding="12,10" Margin="10"
            Background="#E60D0F14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="Heading" Text="SPIKESIGHT" FontFamily="Segoe UI"
                       FontWeight="Bold" FontSize="11" Foreground="#FF4655" Margin="0,0,0,7"/>
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="{Binding NameBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Rank}" FontFamily="Segoe UI"
                                       FontSize="12" Foreground="{Binding RankBrush}"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
