<Window x:Class="SpikeSight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeSight" Height="720" Width="1040" MinWidth="880"
        Background="{StaticResource Surface0}" ShowActivated="False"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal">

    <!-- ShowActivated=False is the whole point: the window appears without
         taking foreground, so launching mid-match does not pull the mouse
         out of the game. -->
    <Window.Resources>

        <!-- Every column width lives here once, so the headings and the rows
             cannot drift apart. -->
        <GridLength x:Key="ColPortrait">44</GridLength>
        <GridLength x:Key="ColRank">124</GridLength>
        <GridLength x:Key="ColForm">186</GridLength>
        <GridLength x:Key="ColFlags">150</GridLength>
        <GridLength x:Key="ColLevel">58</GridLength>

        <DataTemplate x:Key="LobbyRow">
            <Border Margin="0,0,0,2" Padding="12,9" CornerRadius="7" Tag="{Binding Puuid}">
                <Border.ContextMenu>
                    <!-- Flagging is the point of the app, so it is one
                         right-click away from the lobby. -->
                    <ContextMenu>
                        <MenuItem Header="Watch" Tag="1" Click="FlagPlayer"/>
                        <MenuItem Header="Avoid" Tag="2" Click="FlagPlayer"/>
                        <MenuItem Header="Dodge" Tag="3" Click="FlagPlayer"/>
                        <Separator/>
                        <MenuItem Header="Add a note..." Tag="note" Click="FlagPlayer"/>
                        <MenuItem Header="Clear flags"   Tag="0"    Click="FlagPlayer"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Surface1}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface3}"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Surface2}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource ColPortrait}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource ColRank}"/>
                        <ColumnDefinition Width="{StaticResource ColForm}"/>
                        <ColumnDefinition Width="{StaticResource ColFlags}"/>
                        <ColumnDefinition Width="{StaticResource ColLevel}"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" HorizontalAlignment="Left">
                        <Ellipse Width="32" Height="32" Fill="{StaticResource Surface2}"/>
                        <Ellipse Width="32" Height="32">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Portrait}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- Premade colour as a ring, not a stripe: it belongs
                             to the player rather than to the row. -->
                        <Ellipse Width="34" Height="34" StrokeThickness="2"
                                 Stroke="{Binding PartyBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Body}" Text="{Binding Name}"
                                       Foreground="{Binding NameBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Border Style="{StaticResource Chip}" Margin="8,0,0,0"
                                    Background="{Binding NoteTint}"
                                    Visibility="{Binding NoteVisible}">
                                <TextBlock Style="{StaticResource T.Badge}" Text="{Binding Note}"
                                           Foreground="{Binding NoteBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource T.Meta}" Text="{Binding Sub}"
                                   Margin="0,1,0,0" Visibility="{Binding SubVisible}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="3" Height="18" CornerRadius="2" Margin="0,0,9,0"
                                Background="{Binding RankBrush}"/>
                        <TextBlock Style="{StaticResource T.Body}" Text="{Binding Rank}"
                                   Foreground="{Binding RankBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Style="{StaticResource T.Numeric}"
                               Text="{Binding Form}"/>

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0"
                                Background="{StaticResource PrimarySoft}"
                                Visibility="{Binding SmurfVisible}">
                            <TextBlock Style="{StaticResource T.Badge}" Text="{Binding Smurf}"
                                       Foreground="{StaticResource Primary}"/>
                        </Border>
                        <Border Style="{StaticResource Chip}" Background="{Binding PartyTint}"
                                Visibility="{Binding PartyVisible}">
                            <TextBlock Style="{StaticResource T.Badge}" Text="{Binding Party}"
                                       Foreground="{Binding PartyBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="5" Style="{StaticResource T.Meta}"
                               Text="{Binding Level}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== HEADER ===================== -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource T.Display}" Text="SPIKE"
                           Foreground="{StaticResource Primary}"/>
                <TextBlock Style="{StaticResource T.Display}" Text="SIGHT"/>
                <TextBlock Style="{StaticResource T.Meta}" Text="3.0 preview"
                           Margin="10,9,0,0" FontSize="11"/>
                <StackPanel Orientation="Horizontal" Margin="36,7,0,0">
                    <RadioButton x:Name="TabLobby" Style="{StaticResource Tab}" Content="LOBBY"
                                 IsChecked="True" Checked="SwitchView" Tag="lobby"/>
                    <RadioButton x:Name="TabHistory" Style="{StaticResource Tab}" Content="HISTORY"
                                 Checked="SwitchView" Tag="history"/>
                    <RadioButton x:Name="TabMet" Style="{StaticResource Tab}" Content="ENCOUNTERS"
                                 Checked="SwitchView" Tag="met"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource OnLow}"
                         Margin="0,0,10,0"/>
                <Button x:Name="SettingsButton" Content="Settings" Style="{StaticResource Quiet}"
                        Click="ToggleSettings"/>
            </StackPanel>
        </Grid>

        <!-- ===================== SETTINGS ===================== -->
        <Border x:Name="SettingsPane" Grid.Row="1" Visibility="Collapsed"
                Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource T.Label}" Text="SETTINGS" Margin="0,0,0,12"/>
                <CheckBox x:Name="OptOverlay" Style="{StaticResource Option}"
                          Content="Pre-match overlay over agent select" Click="SettingChanged"/>
                <CheckBox x:Name="OptDeepStats" Style="{StaticResource Option}"
                          Content="Fetch recent-match stats (K/D, ACS, Performance Score)"
                          Click="SettingChanged"/>
                <CheckBox x:Name="OptSmurf" Style="{StaticResource Option}"
                          Content="Smurf detection" Click="SettingChanged"/>
                <CheckBox x:Name="OptCloseToTray" Style="{StaticResource Option}"
                          Content="Close to the notification area instead of quitting"
                          Click="SettingChanged"/>
                <CheckBox x:Name="OptAutostart" Style="{StaticResource Option}"
                          Content="Start with Windows" Click="SettingChanged"/>
                <CheckBox x:Name="OptDiagnostics" Style="{StaticResource Option}" Margin="0"
                          Content="Show the diagnostic panel (developer output)"
                          Click="SettingChanged"/>
                <TextBlock x:Name="SettingsNote" Style="{StaticResource T.Meta}"
                           Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ===================== STATUS ===================== -->
        <StackPanel Grid.Row="1" x:Name="StatusRow" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="MatchLine" Style="{StaticResource T.Title}"/>
                <TextBlock x:Name="MatchSub" Style="{StaticResource T.Caption}" Margin="14,3,0,0"/>
            </StackPanel>

            <!-- Win probability as a bar, because a bare percentage reads as
                 a promise and this is a heuristic. -->
            <Grid x:Name="OddsRow" Margin="0,12,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="OddsAlly" Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource Secondary}"/>
                <Border Grid.Column="1" Height="5" CornerRadius="3"
                        Background="{StaticResource PrimarySoft}">
                    <Grid>
                        <Border x:Name="OddsFill" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{StaticResource Secondary}"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2" x:Name="OddsEnemy" Style="{StaticResource T.Caption}"
                           Foreground="{StaticResource Primary}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- ===================== NOTICES ===================== -->
        <StackPanel Grid.Row="2">
            <Border x:Name="UpdateBar" Visibility="Collapsed" Margin="0,0,0,10"
                    Background="{StaticResource PrimarySoft}" BorderBrush="{StaticResource Primary}"
                    BorderThickness="0,0,0,0" CornerRadius="7" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UpdateText" Style="{StaticResource T.Dense}"
                               Foreground="{StaticResource OnHigh}"/>
                    <TextBlock x:Name="UpdateLink" Style="{StaticResource T.Dense}"
                               Foreground="{StaticResource Primary}" FontWeight="SemiBold"
                               Margin="14,0,0,0" Cursor="Hand" Text="Open the release page"
                               MouseLeftButtonUp="OpenRelease"/>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="Alerts" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Tint}" CornerRadius="7" Padding="14,10"
                                Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource T.Badge}" Text="{Binding Title}"
                                           Foreground="{Binding Edge}" Margin="0,1,12,0"/>
                                <TextBlock Style="{StaticResource T.Dense}" Text="{Binding Text}"
                                           Foreground="{StaticResource OnHigh}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ===================== LOBBY ===================== -->
        <ScrollViewer x:Name="LobbyPanel" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Your side, then theirs. Two sections rather than one list,
                     because which side somebody is on is the first thing you
                     need and sorting alone does not say it. -->
                <Grid Margin="0,0,0,8" x:Name="AllyHead">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="14" CornerRadius="2" Margin="0,0,10,0"
                                Background="{StaticResource Secondary}"/>
                        <TextBlock x:Name="AllyLabel" Style="{StaticResource T.Label}"
                                   Foreground="{StaticResource Secondary}"/>
                        <TextBlock x:Name="AllyMeta" Style="{StaticResource T.Meta}"
                                   Margin="12,0,0,0" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource LobbyRow}"/>

                <Grid Margin="0,20,0,8" x:Name="EnemyHead" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="3" Height="14" CornerRadius="2" Margin="0,0,10,0"
                                Background="{StaticResource Primary}"/>
                        <TextBlock x:Name="EnemyLabel" Style="{StaticResource T.Label}"
                                   Foreground="{StaticResource Primary}"/>
                        <TextBlock x:Name="EnemyMeta" Style="{StaticResource T.Meta}"
                                   Margin="12,0,0,0" FontSize="11"/>
                    </StackPanel>
                </Grid>
                <ItemsControl x:Name="EnemyRows" ItemTemplate="{StaticResource LobbyRow}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===================== HISTORY ===================== -->
        <ScrollViewer x:Name="HistoryView" Grid.Row="3" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,2" Padding="12,10" CornerRadius="7">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface1}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="108"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" HorizontalAlignment="Left">
                                    <Ellipse Width="32" Height="32" Fill="{StaticResource Surface2}"/>
                                    <Ellipse Width="32" Height="32">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding Portrait}"
                                                        Stretch="UniformToFill"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Body}" Text="{Binding Map}"/>
                                    <TextBlock Style="{StaticResource T.Meta}" Text="{Binding Queue}"
                                               FontSize="11" Margin="0,1,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Style="{StaticResource T.Title}"
                                           Text="{Binding Score}" Foreground="{Binding ResultBrush}"/>
                                <TextBlock Grid.Column="3" Style="{StaticResource T.Numeric}"
                                           Text="{Binding Kda}"/>
                                <TextBlock Grid.Column="4" Style="{StaticResource T.Numeric}"
                                           Text="{Binding Form}"/>
                                <StackPanel Grid.Column="5" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Body}" Text="{Binding Rr}"
                                               Foreground="{Binding RrBrush}"/>
                                    <TextBlock Style="{StaticResource T.Meta}" Text="{Binding RankAfter}"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===================== ENCOUNTERS ===================== -->
        <ScrollViewer x:Name="MetView" Grid.Row="3" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MetRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,2" Padding="12,10" CornerRadius="7"
                                Tag="{Binding Puuid}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Watch" Tag="1" Click="FlagPlayer"/>
                                    <MenuItem Header="Avoid" Tag="2" Click="FlagPlayer"/>
                                    <MenuItem Header="Dodge" Tag="3" Click="FlagPlayer"/>
                                    <Separator/>
                                    <MenuItem Header="Add a note..." Tag="note" Click="FlagPlayer"/>
                                    <MenuItem Header="Clear flags"   Tag="0"    Click="FlagPlayer"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource Surface1}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Surface2}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Style="{StaticResource T.Body}"
                                           Text="{Binding Who}" TextTrimming="CharacterEllipsis"/>

                                <Border Grid.Column="1" Style="{StaticResource Chip}"
                                        HorizontalAlignment="Left" Background="{Binding NoteTint}"
                                        Visibility="{Binding NoteVisible}">
                                    <TextBlock Style="{StaticResource T.Badge}" Text="{Binding Note}"
                                               Foreground="{Binding NoteBrush}"/>
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource T.Dense}"
                                               Foreground="{StaticResource OnHigh}"
                                               Text="{Binding Met}"/>
                                    <TextBlock Style="{StaticResource T.Meta}" Margin="10,0,0,0"
                                               Text="{Binding Split}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Style="{StaticResource T.Meta}"
                                           Text="{Binding Last}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Diagnostics" Grid.Row="4" Margin="0,14,0,0"
                   FontFamily="Consolas" FontSize="11" Foreground="{StaticResource OnLow}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
