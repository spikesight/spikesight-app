<Window x:Class="SpikeSight.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpikeSight" Height="620" Width="940"
        Background="#0D0F14" ShowActivated="False"
        WindowStartupLocation="CenterScreen">

    <!-- ShowActivated=False is the whole point: the window appears without
         taking foreground, so launching mid-match does not pull the mouse
         out of the game. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#E6E9EF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="View"/>
            <Setter Property="Foreground" Value="#98A1B3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Padding="2,0,2,5" BorderThickness="0,0,0,2"
                                BorderBrush="Transparent" x:Name="Underline">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Underline" Property="BorderBrush" Value="#FF4655"/>
                                <Setter Property="Foreground" Value="#E6E9EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Head" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#6E7687"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="SPIKE" FontWeight="Bold" FontSize="21" Foreground="#FF4655"/>
            <TextBlock Text="SIGHT" FontWeight="Bold" FontSize="21"/>
            <TextBlock Text="v3 preview" FontSize="12" Foreground="#98A1B3" Margin="10,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="28,8,0,0">
                <RadioButton x:Name="TabLobby" Style="{StaticResource Tab}" Content="Lobby"
                             IsChecked="True" Checked="SwitchView" Tag="lobby"/>
                <RadioButton x:Name="TabHistory" Style="{StaticResource Tab}" Content="History"
                             Checked="SwitchView" Tag="history"/>
                <RadioButton x:Name="TabMet" Style="{StaticResource Tab}" Content="Encounters"
                             Checked="SwitchView" Tag="met"/>
            </StackPanel>

            <Button x:Name="SettingsButton" Content="settings" Margin="16,4,0,0" Padding="8,2"
                    FontSize="11" Background="#1C2430" Foreground="#98A1B3"
                    BorderBrush="#2A3240" Click="ToggleSettings"/>
        </StackPanel>

        <Border x:Name="SettingsPane" Grid.Row="1" Visibility="Collapsed"
                Background="#151922" CornerRadius="6" Padding="14,12" Margin="0,8,0,4">
            <StackPanel>
                <CheckBox x:Name="OptOverlay" Content="Pre-match overlay over agent select"
                          Foreground="#E6E9EF" Margin="0,0,0,7" Click="SettingChanged"/>
                <CheckBox x:Name="OptDeepStats" Content="Fetch recent-match stats (K/D, ACS, Performance Score)"
                          Foreground="#E6E9EF" Margin="0,0,0,7" Click="SettingChanged"/>
                <CheckBox x:Name="OptSmurf" Content="Smurf detection"
                          Foreground="#E6E9EF" Margin="0,0,0,7" Click="SettingChanged"/>
                <CheckBox x:Name="OptCloseToTray" Content="Close to the notification area instead of quitting"
                          Foreground="#E6E9EF" Margin="0,0,0,7" Click="SettingChanged"/>
                <CheckBox x:Name="OptAutostart" Content="Start with Windows"
                          Foreground="#E6E9EF" Margin="0,0,0,7" Click="SettingChanged"/>
                <CheckBox x:Name="OptDiagnostics" Content="Show the diagnostic panel (developer output)"
                          Foreground="#E6E9EF" Click="SettingChanged"/>
                <TextBlock x:Name="SettingsNote" FontSize="11" Foreground="#6E7687" Margin="0,9,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="MatchLine" Grid.Row="1" Margin="0,8,0,10"
                   FontSize="13" Foreground="#98A1B3"/>

        <!-- ===================== LOBBY ===================== -->
        <Grid x:Name="LobbyHead" Grid.Row="2" Margin="10,0,10,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="54"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="AGENT"  Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="1" Text="PLAYER" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="2" Text="RANK"   Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="3" Text="RECENT FORM" Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="4" Text="FLAGS"  Style="{StaticResource Head}"/>
            <TextBlock Grid.Column="5" Text="LEVEL"  Style="{StaticResource Head}"
                       HorizontalAlignment="Right"/>
        </Grid>

        <ScrollViewer x:Name="LobbyView" Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,3" Padding="10,7"
                                CornerRadius="4" Tag="{Binding Puuid}">
                            <Border.ContextMenu>
                                <!-- Flagging is the whole point of the app, so
                                     it is one right-click from the lobby. -->
                                <ContextMenu>
                                    <MenuItem Header="Watch"  Tag="1" Click="FlagPlayer"/>
                                    <MenuItem Header="Avoid"  Tag="2" Click="FlagPlayer"/>
                                    <MenuItem Header="Dodge"  Tag="3" Click="FlagPlayer"/>
                                    <Separator/>
                                    <MenuItem Header="Clear flags" Tag="0" Click="FlagPlayer"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#151922"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter Property="Background" Value="#1C2430"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="54"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Agent}" FontSize="12"
                                           Foreground="#98A1B3"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{Binding NameBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Note}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding NoteBrush}" Margin="8,2,0,0"/>
                                    <TextBlock Text="{Binding Met}" FontSize="10"
                                               Foreground="#6E7687" Margin="8,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Rank}" FontSize="13"
                                           Foreground="{Binding RankBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding Form}" FontSize="12"
                                           Foreground="#C8CEDA"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Party}" FontSize="11"
                                               FontWeight="Bold" Foreground="#2FB3A4"
                                               Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Smurf}" FontSize="11"
                                               FontWeight="Bold" Foreground="#FF4655"/>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{Binding Level}" FontSize="12"
                                           Foreground="#98A1B3" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===================== HISTORY ===================== -->
        <ScrollViewer x:Name="HistoryView" Grid.Row="3" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="HistoryRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,3" Padding="10,7" CornerRadius="4"
                                Background="#151922">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="86"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding ResultBrush}"
                                        CornerRadius="2" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Map}" FontSize="13"/>
                                <TextBlock Grid.Column="2" Text="{Binding Queue}" FontSize="12"
                                           Foreground="#98A1B3"/>
                                <TextBlock Grid.Column="3" Text="{Binding Agent}" FontSize="12"
                                           Foreground="#98A1B3"/>
                                <TextBlock Grid.Column="4" Text="{Binding Score}" FontSize="13"
                                           Foreground="{Binding ResultBrush}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Kda}" FontSize="12"
                                           Foreground="#C8CEDA"/>
                                <TextBlock Grid.Column="6" Text="{Binding Form}" FontSize="12"
                                           Foreground="#C8CEDA"/>
                                <TextBlock Grid.Column="7" Text="{Binding Rr}" FontSize="12"
                                           Foreground="{Binding RrBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ===================== ENCOUNTERS ===================== -->
        <ScrollViewer x:Name="MetView" Grid.Row="3" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MetRows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#151922" Margin="0,0,0,3" Padding="10,7"
                                CornerRadius="4" Tag="{Binding Puuid}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Watch"  Tag="1" Click="FlagPlayer"/>
                                    <MenuItem Header="Avoid"  Tag="2" Click="FlagPlayer"/>
                                    <MenuItem Header="Dodge"  Tag="3" Click="FlagPlayer"/>
                                    <Separator/>
                                    <MenuItem Header="Clear flags" Tag="0" Click="FlagPlayer"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Who}" FontSize="13"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="11"
                                           FontWeight="Bold" Foreground="{Binding NoteBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Counts}" FontSize="12"
                                           Foreground="#98A1B3"/>
                                <TextBlock Grid.Column="3" Text="{Binding Last}" FontSize="12"
                                           Foreground="#6E7687" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Diagnostics" Grid.Row="4" Margin="0,12,0,0"
                   FontFamily="Consolas" FontSize="11" Foreground="#6E7687"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
